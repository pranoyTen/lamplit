// The main window: the sidebar, the current screen under its toolbar, and the player bar along the bottom.
import { Theme, ThemeSync, Frame, DragArea } from "theme.slint";
import { Icons, Icon, Clickable, Btn, Muted } from "widgets.slint";
import { State, BookCard, BookPage, Fact, ListRow, DlRow, Tile, BarItem, Recent, LibRow } from "state.slint";
import { HomePage, LibraryPage, BookScreen, DownloadsPage } from "screens.slint";
import { SettingsPage } from "settings.slint";
import { SeriesPage, StatsPage } from "pages.slint";
import { PlayerBar, PlayerPage } from "player.slint";
import { MiniPlayer } from "mini.slint";

export { State, Theme, Frame, BookCard, BookPage, Fact, ListRow, DlRow, Tile, BarItem, Recent, MiniPlayer, LibRow }

// one destination in the sidebar: its icon, and its name unless the sidebar is collapsed
component NavItem inherits Clickable {
    in property <string> text;
    in property <string> icon;
    in property <bool> current;
    in property <bool> compact;
    label: text;
    height: 36px;
    accessible-item-selected: current;
    Rectangle {
        border-radius: 8px;
        background: root.current || root.hover ? Theme.s300 : transparent;
        Rectangle { x: 0; width: 2px; background: root.current ? Theme.ink : transparent; }
    }
    HorizontalLayout {
        padding-left: root.compact ? 0 : 12px;
        spacing: 12px;
        alignment: root.compact ? center : start;
        VerticalLayout {
            alignment: center;
            Icon { d: root.icon; size: 18px; color: root.current ? Theme.ink : Theme.muted; }
        }
        if !root.compact: Text {
            text: root.text;
            vertical-alignment: center;
            color: root.current ? Theme.ink : Theme.ink-2;
            font-weight: root.current ? 600 : 400;
        }
    }
}

// minimise, maximise or restore, and close, as Windows draws them: 46 px wide, a 10 px glyph, the close one red under the mouse
component CaptionBtn inherits TouchArea {
    in property <string> d;
    in property <string> label;
    in property <bool> close;
    width: 46px;
    height: 51px; // the toolbar's rule stays under it
    accessible-role: button;
    accessible-label: label;
    accessible-action-default => { root.clicked(); }
    Rectangle {
        background: root.close && (root.has-hover || root.pressed) ? (root.pressed ? Theme.close.with-alpha(0.85) : Theme.close)
            : root.pressed ? Theme.hairline : root.has-hover ? Theme.s300 : transparent;
    }
    Path {
        width: 10px;
        height: 10px;
        viewbox-width: 10;
        viewbox-height: 10;
        commands: root.d;
        fill: transparent;
        stroke: root.close && (root.has-hover || root.pressed) ? Theme.on-close : Theme.ink;
        stroke-width: 1px;
    }
}

export component AppWindow inherits Window {
    title: "Lamplit";
    preferred-width: 1180px;
    preferred-height: 780px;
    min-width: 940px; // what the player bar needs
    min-height: 560px;
    background: Theme.s100;
    default-font-family: Theme.sans;
    default-font-size: 14px;
    in-out property <string> server; // the sign-in form's address, filled from the last sign-in
    in property <image> app-icon; // set from Rust as plain pixels, like the tray icon
    icon: root.app-icon;
    // the sidebar shows only icons once collapsed with its button
    in-out property <bool> collapsed;
    property <bool> compact: root.collapsed;

    ThemeSync {}
    // keyboard shortcuts (Settings > Keyboard shortcuts); a focused text field gets its keys first, so typing never pauses
    forward-focus: keys;
    keys := FocusScope {
    key-pressed(e) => {
        if e.text == Key.LeftArrow && e.modifiers.alt && (State.route == "book" || State.route == "player") {
            State.route = State.back-route;
            return accept;
        }
        if e.text == " " && State.has-book {
            State.toggle();
            return accept;
        }
        if e.text == Key.LeftArrow && State.has-book {
            State.skip(-State.back-secs);
            return accept;
        }
        if e.text == Key.RightArrow && State.has-book {
            State.skip(State.fwd-secs);
            return accept;
        }
        if e.text == Key.UpArrow {
            State.volume-step(0.05);
            return accept;
        }
        if e.text == Key.DownArrow {
            State.volume-step(-0.05);
            return accept;
        }
        reject
    }
    VerticalLayout {
    HorizontalLayout {
        vertical-stretch: 1;
        Rectangle {
            width: root.compact ? 60px : 220px;
            background: Theme.s200;
            Rectangle { x: parent.width - 1px; width: 1px; background: Theme.hairline; }
            VerticalLayout {
                padding: 12px;
                padding-top: 0;
                padding-left: 8px;
                padding-right: 9px;
                spacing: 2px;
                // as tall as the toolbars, so the two read as one title bar
                Rectangle {
                    height: 52px;
                    DragArea {}
                    HorizontalLayout {
                        alignment: root.compact ? center : space-between;
                        padding-bottom: 0;
                        if !root.compact: HorizontalLayout {
                            padding-left: 10px;
                            spacing: 10px;
                            VerticalLayout {
                                alignment: center;
                                Image { source: @image-url("icons/tray.png"); width: 18px; height: 18px; accessible-role: none; }
                            }
                            Text { text: "Lamplit"; font-weight: 700; font-size: 14px; color: Theme.ink; vertical-alignment: center; }
                        }
                        VerticalLayout {
                        alignment: center;
                    Clickable {
                        label: root.collapsed ? "Expand the sidebar" : "Collapse the sidebar";
                        width: 36px;
                        height: 36px;
                        clicked => { root.collapsed = !root.collapsed; }
                        Rectangle { border-radius: 8px; background: parent.hover ? Theme.s300 : transparent; }
                        Icon { d: Icons.sidebar; size: 18px; color: Theme.muted; }
                    }
                        }
                    }
                }
                Rectangle { height: 4px; }
                NavItem { text: "Home"; icon: Icons.home; compact: root.compact; current: State.route == "home"; enabled: State.signed-in; clicked => { State.route = "home"; } }
                NavItem { text: "Library"; icon: Icons.library; compact: root.compact; current: State.route == "library"; enabled: State.signed-in; clicked => { State.route = "library"; } }
                NavItem {
                    text: "Series";
                    icon: Icons.series;
                    compact: root.compact;
                    current: State.route == "series" || State.route == "series-books";
                    enabled: State.signed-in;
                    clicked => {
                        State.route = "series";
                        State.show-series();
                    }
                }
                NavItem { text: "Downloads"; icon: Icons.downloads; compact: root.compact; current: State.route == "downloads"; clicked => { State.route = "downloads"; } }
                NavItem {
                    text: "Stats";
                    icon: Icons.stats;
                    compact: root.compact;
                    current: State.route == "stats";
                    enabled: State.signed-in;
                    clicked => {
                        State.route = "stats";
                        State.show-stats();
                    }
                }
                Rectangle { vertical-stretch: 1; }
                if !root.compact: VerticalLayout {
                    spacing: 8px;
                    padding: 12px;
                    // found by the check at launch; Settings has the notes and the install button
                    if State.upd-available != "": HorizontalLayout {
                        alignment: start;
                        Btn { small: true; text: "Update to " + State.upd-available; clicked => { State.route = "settings"; } }
                    }
                    if State.offline: Text { text: "Offline: downloaded books still play"; color: Theme.danger; font-size: 12px; wrap: word-wrap; }
                    Muted { text: State.signed-in ? State.signed-in-as : "Not signed in"; font-size: 12px; wrap: word-wrap; }
                }
                NavItem { text: "Settings"; icon: Icons.settings; compact: root.compact; current: State.route == "settings"; clicked => { State.route = "settings"; } }
            }
        }
        VerticalLayout {
            horizontal-stretch: 1;
            Rectangle {
                vertical-stretch: 1;
                // the mouse's back button, wherever nothing else takes the press
                TouchArea {
                    pointer-event(e) => {
                        if e.button == PointerEventButton.back && e.kind == PointerEventKind.up && (State.route == "book" || State.route == "player") {
                            State.route = State.back-route;
                        }
                    }
                }
                if State.route == "home": HomePage { width: 100%; height: 100%; }
                if State.route == "library": LibraryPage { width: 100%; height: 100%; }
                if State.route == "book": BookScreen { width: 100%; height: 100%; }
                if State.route == "player": PlayerPage { width: 100%; height: 100%; }
                if State.route == "downloads": DownloadsPage { width: 100%; height: 100%; }
                if State.route == "series" || State.route == "series-books": SeriesPage { width: 100%; height: 100%; }
                if State.route == "stats": StatsPage { width: 100%; height: 100%; }
                if State.route == "settings": SettingsPage { width: 100%; height: 100%; server <=> root.server; }
                if Frame.custom: HorizontalLayout {
                    width: Frame.buttons-width;
                    height: 51px;
                    x: parent.width - self.width;
                    y: 0;
                    CaptionBtn { label: "Minimise"; d: "M 0 5.5 L 10 5.5"; clicked => { Frame.minimize(); } }
                    CaptionBtn {
                        label: Frame.maximized ? "Restore" : "Maximise";
                        d: Frame.maximized ? "M 2.5 2.5 V 0.5 H 9.5 V 7.5 H 7.5 M 0.5 2.5 H 7.5 V 9.5 H 0.5 Z" : "M 0.5 0.5 H 9.5 V 9.5 H 0.5 Z";
                        clicked => { Frame.toggle-maximized(); }
                    }
                    CaptionBtn { label: "Close"; close: true; d: "M 0 0 L 10 10 M 10 0 L 0 10"; clicked => { Frame.close(); } }
                }
            }
            // messages sit under the screen, so the top row stays free to move the window
            if State.message != "": Rectangle {
                height: msg.preferred-height + 16px;
                background: Theme.s200;
                msg := Text { x: 24px; width: parent.width - 48px; text: State.message; color: Theme.ink; wrap: word-wrap; }
                Rectangle { y: 0; height: 1px; background: Theme.hairline; }
            }
        }
    }
    if State.has-book && State.route != "player": PlayerBar {
        open-player => {
            if State.route != "player" {
                State.back-route = State.route;
            }
            State.route = "player";
        }
    }
    }
    }
}

// The tray icon. Left-click opens the mini player; the menu shows the window, plays or pauses, and quits (closing the window only
// hides it).
export component Tray inherits SystemTrayIcon {
    in property <image> image; // set from Rust as plain pixels: an image embedded for the software renderer cannot become a tray icon
    icon: root.image;
    tooltip: "Lamplit";
    in property <bool> has-book;
    in property <bool> playing;
    callback show-window();
    callback show-mini();
    callback toggle();
    callback quit();
    clicked => { root.show-mini(); }
    Menu {
        MenuItem { title: "Show Lamplit"; activated => { root.show-window(); } }
        MenuItem { title: root.playing ? "Pause" : "Play"; enabled: root.has-book; activated => { root.toggle(); } }
        MenuItem { title: "Quit"; activated => { root.quit(); } }
    }
}
