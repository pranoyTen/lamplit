// Series and Stats.
import { ScrollView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { Icons, Clickable, Link, Bar, Card, Cover, H1, H2, Muted } from "widgets.slint";
import { BookGrid, Pill } from "screens.slint";
import { State } from "state.slint";

export component SeriesPage {
    sv := ScrollView {
        width: 100%;
        height: 100%;
        VerticalLayout {
            width: sv.visible-width;
            padding: 32px;
            spacing: 24px;
            alignment: start;
            if State.route == "series": VerticalLayout {
                spacing: 24px;
                H1 { text: "Series"; }
                if State.series-list.length == 0: Muted { text: State.series-loading ? "Loading…" : "No series in your libraries"; }
                BookGrid {
                    books: State.series-list;
                    series: true;
                    view-top: -sv.content-y - self.y;
                    view-height: sv.visible-height;
                    need(a, b) => { State.covers-needed("series", a, b); }
                }
            }
            if State.route == "series-books": VerticalLayout {
                spacing: 24px;
                HorizontalLayout {
                    alignment: start;
                    Link { text: "All series"; icon: Icons.left; clicked => { State.route = "series"; } }
                }
                VerticalLayout {
                    H1 { text: State.series-title; }
                    Muted { text: State.series-count; }
                }
                BookGrid { books: State.series-books; }
            }
        }
    }
}

// a big number with its label, one of the four at the top of Stats
component TileCard inherits Card {
    in property <string> label;
    in property <string> value;
    horizontal-stretch: 1;
    VerticalLayout {
        padding: 20px;
        spacing: 4px;
        Muted { text: root.label; font-size: 12px; }
        Text { text: root.value; font-family: Theme.serif; font-weight: 600; font-size: 28px; color: Theme.ink; overflow: elide; }
    }
}

export component StatsPage {
    sv := ScrollView {
        width: 100%;
        height: 100%;
        VerticalLayout {
            width: sv.visible-width;
            padding: 32px;
            spacing: 32px;
            alignment: start;
            HorizontalLayout {
                spacing: 16px;
                VerticalLayout {
                    horizontal-stretch: 1;
                    H1 { text: "Stats"; }
                    Muted { text: State.stats-subtitle; }
                }
                VerticalLayout {
                    alignment: end;
                    HorizontalLayout {
                        spacing: 8px;
                        for r[i] in ["Week", "Month", "Year"]: Pill {
                            text: r;
                            on: State.stats-range == i;
                            clicked => {
                                State.stats-range = i;
                                State.show-stats();
                            }
                        }
                    }
                }
            }
            if State.stats-loading: Muted { text: "Loading…"; }
            HorizontalLayout {
                spacing: 16px;
                for t in State.tiles: TileCard { label: t.label; value: t.value; }
            }
            if State.chart.length > 0: Card {
                VerticalLayout {
                    padding: 24px;
                    spacing: 16px;
                    H2 { text: State.chart-title; }
                    // the bars, tallest at 196 px; the latest (today, or this month) in the brand colour
                    HorizontalLayout {
                        height: 220px;
                        spacing: State.chart.length <= 12 ? 12px : 4px;
                        for b in State.chart: VerticalLayout {
                            horizontal-stretch: 1;
                            alignment: end;
                            spacing: 4px;
                            if State.chart.length <= 12: Text { text: b.text; font-size: 12px; font-weight: 500; color: Theme.ink; horizontal-alignment: center; }
                            Rectangle {
                                height: max(b.value > 0 ? 2px : 0px, 196px * b.value);
                                border-radius: 2px;
                                background: b.current ? Theme.brand : Theme.accent;
                            }
                        }
                    }
                    HorizontalLayout {
                        spacing: State.chart.length <= 12 ? 12px : 4px;
                        for b in State.chart: Muted { text: b.label; font-size: 12px; horizontal-alignment: center; horizontal-stretch: 1; min-width: 0; }
                    }
                }
            }
            HorizontalLayout {
                spacing: 24px;
                alignment: start;
                VerticalLayout {
                    spacing: 12px;
                    horizontal-stretch: 1;
                    min-width: 0;
                    alignment: start;
                    VerticalLayout {
                        H2 { text: "Most listened authors"; }
                        Muted { text: "All time"; font-size: 12px; }
                    }
                    if State.top-authors.length == 0: Muted { text: "Nothing yet"; }
                    for a in State.top-authors: VerticalLayout {
                        spacing: 4px;
                        HorizontalLayout {
                            Text { text: a.label; font-weight: 500; color: Theme.ink; horizontal-stretch: 1; overflow: elide; }
                            Muted { text: a.text; }
                        }
                        Bar { value: a.value; thick: 6px; }
                    }
                }
                VerticalLayout {
                    spacing: 12px;
                    horizontal-stretch: 1;
                    min-width: 0;
                    alignment: start;
                    VerticalLayout {
                        H2 { text: "Recently finished"; }
                        Muted { text: "Latest five"; font-size: 12px; }
                    }
                    if State.recent-finished.length == 0: Muted { text: "No finished books yet"; }
                    for f in State.recent-finished: Clickable {
                        label: f.title;
                        height: 48px;
                        clicked => { State.open-book(f.id); }
                        HorizontalLayout {
                            spacing: 12px;
                            VerticalLayout {
                                alignment: center;
                                Cover { width: 40px; height: 40px; img: f.cover; title: ""; tint: f.tint; }
                            }
                            VerticalLayout {
                                alignment: center;
                                horizontal-stretch: 1;
                                min-width: 0;
                                Text { text: f.title; font-weight: 500; color: Theme.ink; overflow: elide; }
                                Muted { text: f.author; font-size: 12px; }
                            }
                            Muted { text: f.when; font-size: 12px; vertical-alignment: center; }
                        }
                    }
                }
            }
        }
    }
}
