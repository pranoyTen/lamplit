// Lamplit's design tokens: the Ink theme from the desktop redesign. Plain paper, a black with no hue and hairline rules; the
// covers carry the colour, and teal means playing or in progress.
import { Palette } from "std-widgets.slint";

export global Theme {
    in-out property <bool> dark;
    // only in the mini player on a Mac: the system's neutral colours, translucent so they sit on the window's blur
    in-out property <bool> mac;
    // set from Rust per platform: Segoe UI on Windows, the system font elsewhere
    in-out property <string> sans: "Segoe UI";

    out property <color> s100: dark ? #0f0f0f : #fefdfb; // the page
    out property <color> s200: dark ? #171717 : #f6f5f2; // the sidebar, the player bar, wells
    out property <color> s300: dark ? #222222 : #ecebe7; // hover, the current item
    out property <color> raised: s200;
    out property <color> ink: mac ? (dark ? #f5f5f7 : #1d1d1f) : (dark ? #f2f2f2 : #0d0d0d);
    out property <color> ink-2: dark ? #d1d1d1 : #292929;
    out property <color> muted: mac ? (dark ? #a1a1a6 : #6e6e73) : (dark ? #9e9e9e : #525252);
    out property <color> hairline: dark ? #303030 : #dbdbd8;
    out property <color> border-strong: dark ? #4a4a4a : #c4c4c0;
    out property <color> accent: dark ? #60bdb5 : #00746d;
    out property <color> accent-soft: dark ? #0d3d3b : #c3f3ef;
    out property <color> accent-soft-ink: dark ? #cbf1ee : #022d2b;
    out property <color> brand: accent; // progress and the playing item
    // the round play button and the filled button
    out property <color> main: ink;
    out property <color> on-main: mac ? (dark ? #1d1d1f : #ffffff) : s100;
    out property <color> track: mac ? (dark ? #ffffff38 : #00000024) : hairline;
    out property <color> danger: dark ? #ef806f : #be2323;
    out property <color> focus: accent;
    out property <color> hover: mac ? (dark ? #ffffff1f : #00000012) : s300;
    out property <color> cover-text: #f8f5ee;
    out property <color> shadow: dark ? #000000cc : #00000040;
    // the close button under the mouse: the system's own red, the same in light and dark
    out property <color> close: #c42b1c;
    out property <color> on-close: #ffffff;
}

// the title bar Lamplit draws itself on Windows (src/frame.rs): every toolbar moves the window, the buttons sit top right
export global Frame {
    in-out property <bool> custom;
    in-out property <bool> maximized;
    out property <length> buttons-width: custom ? 3 * 46px : 0;
    callback drag();
    callback minimize();
    callback toggle-maximized();
    callback close();
}

// an empty part of a toolbar: dragging moves the window, a double click maximises or restores it, like a title bar
export component DragArea inherits TouchArea {
    property <bool> dragged;
    enabled: Frame.custom;
    pointer-event(e) => {
        if e.kind == PointerEventKind.down {
            self.dragged = false;
        }
    }
    // only once the mouse moves, so a double click still arrives; Windows then takes the button up, so this waits for the next press
    moved => {
        if self.pressed && !self.dragged {
            self.dragged = true;
            Frame.drag();
        }
    }
    double-clicked => { Frame.toggle-maximized(); }
}

// keeps the standard widgets (text fields, menus, scroll bars) in the same light or dark scheme
export component ThemeSync {
    width: 0;
    height: 0;
    property <bool> dark: Theme.dark;
    init => {
        Palette.color-scheme = self.dark ? ColorScheme.dark : ColorScheme.light;
    }
    changed dark => {
        Palette.color-scheme = self.dark ? ColorScheme.dark : ColorScheme.light;
    }
}
