{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lectern",
  "version": "0.1.0",
  "identifier": "app.lectern.desktop",
  "build": { "frontendDist": "../src" },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      { "title": "Lectern", "width": 1280, "height": 860, "minWidth": 900, "minHeight": 600 }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
