{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lectern",
  "version": "1.0.0",
  "identifier": "app.lectern.desktop",
  "build": { "frontendDist": "../src" },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      { "title": "Lectern", "width": 1280, "height": 860, "minWidth": 900, "minHeight": 600, "decorations": false }
    ],
    "security": { "csp": null, "assetProtocol": { "enable": true, "scope": ["$APPDATA/downloads/**"] } }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.icns", "icons/icon.ico"]
  },
  "plugins": {
    "updater": {
      "pubkey": "REPLACE_WITH_PUBLIC_KEY",
      "endpoints": ["https://raw.githubusercontent.com/pranoyTen/lectern/updates/latest.json"]
    }
  }
}
